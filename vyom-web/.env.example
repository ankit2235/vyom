# Base URL of the future marketing/backend form endpoint.
#
# Leave EMPTY until that endpoint exists. While it is empty,
# submitBenchmarkRequest() builds a pre-filled mailto: link and nothing is
# sent anywhere. Setting it switches that one function to POST instead —
# see src/lib/api.ts.
NEXT_PUBLIC_API_URL=

# Base URL of vyom-os (FastAPI). Used by src/lib/gateway/api-client.ts.
# Leave EMPTY until the OS API is reachable. Example: http://127.0.0.1:8000
NEXT_PUBLIC_VYOM_OS_URL=

# Apex domain for tenant subdomains (optional). Example: vyom.in
# When set, middleware treats {slug}.{domain} as the active tenant.
NEXT_PUBLIC_ROOT_DOMAIN=

# Canonical origin for canonical URLs, sitemap.xml and the Open Graph image.
#
# Leave EMPTY on Vercel: the build falls back to the project's production
# vercel.app domain. Set it to the real origin (no trailing slash) once a
# custom domain is live, e.g. https://vyom.in
NEXT_PUBLIC_SITE_URL=
