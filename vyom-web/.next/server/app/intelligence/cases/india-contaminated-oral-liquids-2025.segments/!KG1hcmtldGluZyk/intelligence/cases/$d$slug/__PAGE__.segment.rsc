shrink-0 rounded-full border border-secondary"}],"HISTORICAL CASE"]}]}]]]}],["$","h1",null,{"className":"m-0 max-w-[920px] text-[clamp(32px,4vw,52px)] leading-[1.08] font-semibold tracking-[-0.03em] text-balance text-primary","children":"Contaminated Oral Liquid Medicines, India"}],["$","p",null,{"className":"m-0 max-w-[780px] text-[18px] leading-[1.6] text-pretty text-muted","children":"WHO Medical Product Alert N°5/2025 names specific batches of three oral liquid medicines found to contain diethylene glycol (DEG), reported to WHO by India’s CDSCO on 8 October 2025 after clusters of acute illness and child deaths."}],null,["$","$L14",null,{"record":{"slug":"india-contaminated-oral-liquids-2025","title":"Contaminated Oral Liquid Medicines, India","origin":"historical-case","categories":["drug-quality","substandard-or-falsified","regulatory-action","official-alert"],"statuses":["official-alert","historical-case"],"products":[{"name":"COLDRIF","form":"Oral liquid","activeIngredients":["Paracetamol","Chlorpheniramine maleate","Phenylephrine","Sodium citrate"],"batches":[{"batch":"SR-13","manufactured":"05/2025","expires":"04/2027","finding":"48.6% w/v DEG (as reported by CDSCO)","basis":"official","sourceIds":["who-n5-2025-pdf"]}]},{"name":"Respifresh TR","form":"Oral liquid","activeIngredients":["Bromhexine hydrochloride","Terbutaline sulphate","Guaiphenesin","Menthol"],"batches":[{"batch":"R01GL2523","manufactured":"01/2025","expires":"12/2026","finding":"1.34% w/v DEG (as reported by CDSCO)","basis":"official","sourceIds":["who-n5-2025-pdf"]}]},{"name":"ReLife","form":"Oral liquid","activeIngredients":["Ambroxol HCl","Guaiphenesin","Terbutaline sulphate","Menthol"],"batches":[{"batch":"LSL25160","manufactured":"01/2025","expires":"12/2026","finding":"0.61% w/v DEG (as reported by CDSCO)","basis":"official","sourceIds":["who-n5-2025-pdf"]}]}],"location":{"country":"India","note":"The alert does not state where the illnesses occurred."},"eventDate":{"label":"Identified by WHO on 30 Sep 2025","sourceIds":["who-n5-2025-pdf"]},"summary":"WHO Medical Product Alert N°5/2025 names specific batches of three oral liquid medicines found to contain diethylene glycol (DEG), reported to WHO by India’s CDSCO on 8 October 2025 after clusters of acute illness and child deaths.","whyItMatters":"The alert names exact batches, not whole brands. Any investigation has to match product, batch and manufacturer before treating a report as related.","parties":[{"role":"manufacturer","name":"Sresan Pharmaceutical","place":"Kancheepuram","basis":"official","sourceIds":["who-n5-2025-pdf"],"note":"COLDRIF, batch SR-13."},{"role":"manufacturer","name":"Rednex Pharmaceutical Pvt Ltd.","place":"Bavla, Ahmedabad, Gujarat","basis":"official","sourceIds":["who-n5-2025-pdf"],"note":"Respifresh TR, batch R01GL2523."},{"role":"manufacturer","name":"Shape Pharma Pvt. Ltd.","place":"Shekhpur, Gujarat","basis":"official","sourceIds":["who-n5-2025-pdf"],"note":"ReLife, batch LSL25160."},{"role":"regulator","name":"Central Drugs Standard Control Organization (CDSCO)","basis":"official","sourceIds":["who-n5-2025","who-n5-2025-pdf"],"note":"Reported DEG in at least three oral liquid medicines to WHO on 8 October 2025."}],"statements":[{"text":"On 30 September 2025, WHO identified information on localised clusters of acute illness and child fatalities in India.","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"text":"On 8 October 2025, CDSCO reported to WHO the presence of diethylene glycol in at least three oral liquid medicines.","basis":"official","sourceIds":["who-n5-2025","who-n5-2025-pdf"]},{"text":"CDSCO informed WHO that the contaminated products were reportedly consumed by the affected children.","basis":"official","sourceIds":["who-n5-2025-pdf"],"quote":"reportedly consumed by the affected children"},{"text":"The contaminated medicines are specific batches of COLDRIF, Respifresh TR and ReLife.","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"text":"State authorities ordered an immediate halt to production at the implicated sites, suspended product authorisations and initiated a recall.","basis":"official","sourceIds":["who-n5-2025","who-n5-2025-pdf"]},{"text":"CDSCO informed WHO that none of the contaminated medicines had been exported and there was no evidence of illegal export.","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"text":"WHO advised regulators to evaluate oral liquid medicines from the same manufacturing sites, particularly those produced since December 2024.","basis":"official","sourceIds":["who-n5-2025-pdf"]}],"scopeNote":"Only the three batches below are named in the alert. It does not say that other batches, or every product sold under these brand names, are affected.","healthConcerns":[{"text":"Diethylene glycol is toxic to humans when consumed and can prove fatal. Use, especially in children, may result in serious injury or death.","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"text":"Toxic effects listed by WHO include abdominal pain, vomiting, diarrhoea, inability to pass urine, headache, altered mental state and acute kidney injury, which may lead to death.","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"text":"The alert describes clusters of acute illness and child fatalities, but gives no number of cases or deaths.","basis":"not-established","sourceIds":["who-n5-2025-pdf"]}],"actions":[{"text":"State authorities ordered an immediate halt to production at the implicated manufacturing sites.","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"text":"State authorities suspended product authorisations and initiated a recall of the contaminated products.","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"text":"WHO advised regulators to consider targeted market surveillance, especially of informal and unregulated supply chains.","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"text":"WHO asked authorities to notify it immediately if these products are detected in their country.","basis":"official","sourceIds":["who-n5-2025-pdf"]}],"timeline":[{"date":"2024-12-01","dateLabel":"December 2024 onwards","kind":"regulatory","title":"Production window WHO asks regulators to review","detail":"WHO advised evaluating oral liquid medicines from the same sites, particularly those produced since December 2024.","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"date":"2025-09-30","dateLabel":"30 Sep 2025","kind":"clinical","title":"WHO identifies clusters of acute illness and child deaths in India","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"date":"2025-10-08","dateLabel":"8 Oct 2025","kind":"testing","title":"CDSCO reports diethylene glycol in at least three oral liquid medicines to WHO","detail":"Contamination levels in the annex are as reported by CDSCO: 48.6%, 1.34% and 0.61% w/v DEG.","basis":"official","sourceIds":["who-n5-2025","who-n5-2025-pdf"]},{"date":null,"dateLabel":"Date not stated · reported 13 Oct 2025","kind":"regulatory","title":"State authorities halt production, suspend authorisations and start a recall","basis":"official","sourceIds":["who-n5-2025-pdf"]},{"date":"2025-10-13","dateLabel":"13 Oct 2025","kind":"regulatory","title":"WHO publishes Medical Product Alert N°5/2025","basis":"official","sourceIds":["who-n5-2025","who-n5-2025-pdf"]},{"date":null,"dateLabel":"Open at publication","kind":"investigation","title":"Source of the contamination","detail":"WHO said it continues to work with Indian authorities to identify the source of the contamination.","basis":"not-established","sourceIds":["who-n5-2025-pdf"]}],"gaps":["The alert does not state where the illnesses occurred or how many children were affected.","The source of the contamination was still being identified when the alert was published.","Only the listed batches are named; the alert does not say whether other batches were tested."],"sourceIds":["who-n5-2025","who-n5-2025-pdf"],"history":[{"on":"2026-10-27","kind":"source-read","change":"Read by hand: WHO alert page, 13 Oct 2025."},{"on":"2026-10-27","kind":"source-read","change":"Read by hand: WHO alert PDF with annex, 13 Oct 2025."},{"on":"2026-10-27","kind":"created","change":"Record created from the WHO alert."},{"on":"2026-10-27","kind":"classified","change":"Each statement labelled by how well its sources support it."},{"on":"2026-10-27","kind":"correction","change":"A state name (Tamil Nadu) removed from a manufacturer address: the alert does not state it."}]}}]]}]}],"$L15"],["$L16","$L17"],"$L18"]}],"p":"$@19","v":null,"s":"$9"}}]]
