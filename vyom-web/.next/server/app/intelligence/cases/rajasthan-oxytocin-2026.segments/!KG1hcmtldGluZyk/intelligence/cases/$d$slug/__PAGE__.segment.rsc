0:{"t":{"t":{"s":"","h":16,"c":"$Q1"},"h":{"r":["$","$3","h",{"children":[null,["$","$L1b",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","2",{"name":"theme-color","content":"#070B14"}],["$","meta","3",{"name":"color-scheme","content":"dark"}]]}],["$","$L1d",null,{"children":[["$","div",null,{"hidden":true,"children":["$","$1e",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"Rajasthan Oxytocin Quality Investigation — Vyom"}],["$","meta","1",{"name":"description","content":"After five women died following childbirth at two Kota hospitals, Rajasthan banned a TOCIN oxytocin injection whose sample failed quality testing, and later cancelled a Kota distributor’s licence. State and AIIMS investigations reported by The Indian Express did not attribute the deaths to the ineffective drug, and described gaps in clinical monitoring and documentation."}],["$","meta","2",{"name":"robots","content":"noindex, nofollow, nocache"}],["$","meta","3",{"property":"og:title","content":"Rajasthan Oxytocin Quality Investigation — Vyom"}],["$","meta","4",{"property":"og:description","content":"After five women died following childbirth at two Kota hospitals, Rajasthan banned a TOCIN oxytocin injection whose sample failed quality testing, and later cancelled a Kota distributor’s licence. State and AIIMS investigations reported by The Indian Express did not attribute the deaths to the ineffective drug, and described gaps in clinical monitoring and documentation."}],["$","meta","5",{"property":"og:url","content":"http://localhost:3000/"}],["$","meta","6",{"property":"og:site_name","content":"Vyom"}],["$","meta","7",{"property":"og:locale","content":"en_IN"}],["$","meta","8",{"property":"og:image","content":"http://localhost:3000/opengraph-image.png?opengraph-image.0uirccfj542k4.png"}],["$","meta","9",{"property":"og:image:type","content":"image/png"}],["$","meta","10",{"property":"og:image:width","content":"1200"}],["$","meta","11",{"property":"og:image:height","content":"630"}],["$","meta","12",{"property":"og:type","content":"website"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"Rajasthan Oxytocin Quality Investigation — Vyom"}],["$","meta","15",{"name":"twitter:description","content":"After five women died following childbirth at two Kota hospitals, Rajasthan banned a TOCIN oxytocin injection whose sample failed quality testing, and later cancelled a Kota distributor’s licence. State and AIIMS investigations reported by The Indian Express did not attribute the deaths to the ineffective drug, and described gaps in clinical monitoring and documentation."}],["$","meta","16",{"name":"twitter:image","content":"http://localhost:3000/twitter-image.png?twitter-image.0uirccfj542k4.png"}],["$","meta","17",{"name":"twitter:image:type","content":"image/png"}],["$","meta","18",{"name":"twitter:image:width","content":"1200"}],["$","meta","19",{"name":"twitter:image:height","content":"630"}],["$","link","20",{"rel":"icon","href":"/favicon.ico?favicon.42e8si0_v04bj.ico","sizes":"48x48","type":"image/x-icon"}],["$","link","21",{"rel":"icon","href":"/icon.svg?icon.24ubjbw6iw6rl.svg","sizes":"any","type":"image/svg+xml"}],["$","link","22",{"rel":"apple-touch-icon","href":"/apple-icon.png?apple-icon.1sdst7sipceq9.png","sizes":"180x180","type":"image/png"}],["$","$L1f","23",{}]]}]}],null]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}],"p":"$@20","v":null,"s":"$9"}},"a":"$@21","u":"$@22","b":"3_06QXXu8UAqInUvQ_ESw"}
