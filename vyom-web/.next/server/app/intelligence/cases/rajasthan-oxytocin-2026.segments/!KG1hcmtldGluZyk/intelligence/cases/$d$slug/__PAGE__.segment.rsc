e:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$3","c",{"children":[[["$","section",null,{"className":"border-b border-hairline","children":["$","div",null,{"className":"mx-auto w-full max-w-[1280px] px-4 sm:px-8 flex flex-col gap-6 py-12 sm:py-16","children":[["$","$L13",null,{"href":"/intelligence","className":"inline-flex min-h-[44px] items-center gap-2 self-start text-[14px] font-medium text-secondary hover:text-primary","children":[["$","svg",null,{"width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","className":"rotate-180","children":[["$","path",null,{"d":"M5 12h14"}],["$","path",null,{"d":"M13 6l6 6-6 6"}]]}],"All records"]}],["$","span",null,{"className":"font-mono text-[12px] font-medium tracking-[0.14em] text-accent uppercase","children":"SAFETY INTELLIGENCE · PREVIEW"}],["$","div",null,{"className":"flex flex-wrap gap-2","children":[["$","span",null,{"className":"inline-flex items-center rounded-chip border font-mono font-medium tracking-[0.08em] whitespace-nowrap border-solid border-strong text-secondary px-2 py-1 text-[11px] text-primary","children":"PUBLIC SOURCE"}],[["$","span","reported-by-media",{"className":"inline-flex","children":["$","span",null,{"className":"inline-flex items-center rounded-chip border font-mono font-medium tracking-[0.08em] whitespace-nowrap border-solid border-strong text-secondary px-2 py-1 text-[11px]","children":[["$","span",null,{"aria-hidden":"true","className":"mr-1.5 inline-block size-1.5 shrink-0 rounded-full border border-secondary"}],"REPORTED BY MEDIA"]}]}],["$","span","historical-case",{"className":"inline-flex","children":["$","span",null,{"className":"inline-flex items-center rounded-chip border font-mono font-medium tracking-[0.08em] whitespace-nowrap border-solid border-strong text-secondary px-2 py-1 text-[11px]","children":[["$","span",null,{"aria-hidden":"true","className":"mr-1.5 inline-block size-1.5 shrink-0 rounded-full border border-secondary"}],"HISTORICAL CASE"]}]}],["$","span","causality-not-established",{"className":"inline-flex","children":["$","span",null,{"className":"inline-flex items-center rounded-chip border font-mono font-medium tracking-[0.08em] whitespace-nowrap border-dashed border-dash text-muted px-2 py-1 text-[11px]","children":[["$","span",null,{"aria-hidden":"true","className":"mr-1.5 inline-block size-1.5 shrink-0 rounded-full border border-dashed border-muted"}],"CAUSALITY NOT ESTABLISHED"]}]}]]]}],["$","h1",null,{"className":"m-0 max-w-[920px] text-[clamp(32px,4vw,52px)] leading-[1.08] font-semibold tracking-[-0.03em] text-balance text-primary","children":"Rajasthan Oxytocin Quality Investigation"}],["$","p",null,{"className":"m-0 max-w-[780px] text-[18px] leading-[1.6] text-pretty text-muted","children":"After five women died following childbirth at two Kota hospitals, Rajasthan banned a TOCIN oxytocin injection whose sample failed quality testing, and later cancelled a Kota distributor’s licence. State and AIIMS investigations reported by The Indian Express did not attribute the deaths to the ineffective drug, and described gaps in clinical monitoring and documentation."}],["$","p",null,{"role":"note","className":"m-0 max-w-[860px] rounded-card border border-dashed border-secondary bg-panel px-5 py-4 text-[15.5px] leading-[1.55] font-medium text-primary","children":"Causality not established. The investigations reported in the sources did not show that this product caused the deaths or harm described. Treat every link below as unproven unless a source says otherwise."}],"$L14"]}]}],"$L15"],["$L16","$L17"],"$L18"]}],"p":"$@19","v":null,"s":"$9"}}]]
